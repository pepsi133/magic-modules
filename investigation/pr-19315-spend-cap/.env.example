# Template for the local .env. Keep the real file OUTSIDE the repository (parent directory of the clone). Load with: set -a; . <parent>/.env; set +a
# Project ID that hosts the tests; must be billed directly by GOOGLE_BILLING_ACCOUNT.
GOOGLE_PROJECT=my-test-project
# Project number of GOOGLE_PROJECT (gcloud projects describe "$GOOGLE_PROJECT" --format='value(projectNumber)').
GOOGLE_PROJECT_NUMBER=123456789012
# Numeric organization ID that owns GOOGLE_PROJECT. Needed by tests that create their own project: the variant A sample and the variant A handwritten spend-cap tests.
GOOGLE_ORG=000000000000
# First-party, self-serve, spend-cap-eligible billing account that bills GOOGLE_PROJECT.
GOOGLE_BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX
# Billing account the budget tests create budgets on (MASTER_BILLING_ACCT); locally the same as GOOGLE_BILLING_ACCOUNT.
GOOGLE_MASTER_BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX
# Default region for the provider (not used by budgets, but required by the test harness).
GOOGLE_REGION=us-central1
# Default zone for the provider (not used by budgets, but required by the test harness).
GOOGLE_ZONE=us-central1-a
# Variant B only: a first-party, spend-cap-eligible billing account that bills GOOGLE_PROJECT. The tests use USD: use a USD account, or the test account with the local currency edit (HANDOVER section e). Leave empty to skip the handwritten spend-cap tests.
GOOGLE_SPEND_CAP_BILLING_ACCOUNT=
# GOOGLE_CREDENTIALS is not set here. Export it only in the shell that runs acceptance tests, see HANDOVER section e. No ADC.
